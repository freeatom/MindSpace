{
  "name": "mindspace",
  "version": "1.0.0",
  "description": "MindSpace — Your mind, extended. A minimalist productivity desktop app.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "ABeezzz LABS",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.2"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "interactjs": "^1.10.27",
    "nedb-promises": "^6.2.3",
    "node-notifier": "^10.0.1"
  },
  "build": {
    "appId": "com.abeezzz.mindspace",
    "productName": "MindSpace",
    "win": {
      "target": "nsis"
    },
    "files": [
      "**/*"
    ],
    "asar": true
  }
}
